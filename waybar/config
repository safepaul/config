{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["bluetooth", "pulseaudio", "network", "clock", "tray"],

  "bluetooth": {
    "format": " {status}",
    "format-disabled": "󰂲 Off",
    "format-off": "󰂲 Off",
    "format-connected": "󰂱 {device_alias}",
    "on-click": "foot --app-id=bluetui_float -e bluetuith",
    "on-click-right": "rfkill toggle bluetooth"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "󰂱 {icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
  },
    "scroll-step": 5,
    "on-click": "foot --app-id=pulsemixer_float -e pulsemixer",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} | {volume}%"
  },

  "network": {
    "format-wifi": "   on",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭   no conn",
    "format-disabled": "󰤭   off",
    "tooltip-format": "{ifname} via {gwaddr} 󰈀",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) \nIP: {ipaddr}\nFreq: {frequency}MHz",
    "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}\nSpeed: {bandwidthDownBits}",
    "on-click": "foot --app-id=nmtui_float -e nmtui",
    "on-click-right": "rfkill toggle wifi",
  },

  "clock": {
    "format": "{:%a, %b %d    %H:%M}"
  }
}
